# ─── LLM provider (default: bifrost proxy) ─────────────────────────────
# Bifrost is OpenAI-compatible at /openai (NOT /anthropic — that mount is
# only for Anthropic-format requests). Auth uses the x-bf-vk header
# (virtual key), NOT Authorization: Bearer.
AI_PROVIDER=bifrost
BIFROST_BASE_URL=https://<bifrost-proxy>/openai
BIFROST_MODEL=minimax/minimax-m3
# AI_FALLBACK_PROVIDER=fixture
BIFROST_API_KEY=

# ─── Direct OpenAI (only used when AI_PROVIDER=openai) ────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Observability (Day 6 + Day 7) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
